# Copy this file to `.env` and fill in only the values you use.
# `.env` is gitignored; never commit real keys.

GROQ_API_KEY=gsk_your_groq_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# Optional, only if you use the Gemini judge:
# GEMINI_API_KEY=your_gemini_key_here

# Comma-separated browser origins allowed by the FastAPI dashboard backend.
# Local development works with the default localhost origin. Set this explicitly
# in production, e.g. https://ragval.vercel.app
RAGVAL_CORS_ORIGINS=http://localhost:5173
