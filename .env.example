# Copy this file to `.env` and fill in your keys. ragval loads `.env`
# automatically on import — no need to `export` or `source` anything.
# `.env` is gitignored; never commit real keys.
GROQ_API_KEY=gsk_your_groq_key_here
ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here
# Optional, only if you use the Gemini judge:
# GEMINI_API_KEY=your_gemini_key_here
